# ========================================================
# Rydr Environment Configuration Sample
# Copy to .env for local development
# ========================================================

# PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Service Database URLs (Local IDE Execution)
DB_USER_URL=jdbc:postgresql://localhost:5433/users
DB_TRIP_URL=jdbc:postgresql://localhost:5433/trips
DB_RATING_URL=jdbc:postgresql://localhost:5433/ratings
DB_PAYMENT_URL=jdbc:postgresql://localhost:5433/payments

DB_USER_USERNAME=postgres
DB_USER_PASSWORD=postgres

# Redis Configuration (Location Service & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka Configuration (Event Streaming)
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:9092
